# =============================================================================
# ERLEN CRM – Umgebungsvariablen (Vorlage)
# Kopiere diese Datei zu ".env.local" (lokal) bzw. trage die Werte in Vercel ein.
# Trage hier NIEMALS echte Zugangsdaten ein – diese Datei liegt im Git-Repository.
# =============================================================================

# Supabase → Project Settings → API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Öffentliche Adresse des Portals (ohne Schrägstrich am Ende), z. B. https://www.erlen-sales.de
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hinweis: Mit der Supabase-Integration in Vercel werden die Werte automatisch angelegt
# (NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, POSTGRES_URL_NON_POOLING …) –
# die App versteht beide Schreibweisen.

# Direkte Datenbankverbindung (nur für die Ersteinrichtung unter /einrichtung)
POSTGRES_URL_NON_POOLING=

# GEHEIM – nur serverseitig! Supabase → Project Settings → API Keys → "Secret key" (sb_secret_…)
SUPABASE_SECRET_KEY=sb_secret_xxx

# Zufällige Zeichenkette (mind. 16 Zeichen) für anonymisierte Ratenbegrenzung
RATE_LIMIT_SALT=bitte-durch-zufaellige-zeichenkette-ersetzen

# Erlaubte Website-Adressen für das Bewerbungsformular (kommagetrennt)
APPLICATION_ALLOWED_ORIGINS=

# E-Mail-Versand (Einladungen, Terminbestätigungen/-erinnerungen, Hinweis auf neue Gutschriften)
# Variante A – Microsoft 365 / Outlook über Microsoft Graph (empfohlen für Outlook, ohne Postfach-Passwort)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Variante B – SMTP (Outlook/Microsoft 365: smtp.office365.com, Port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Variante C – Resend (https://resend.com)
RESEND_API_KEY=
# Absender (muss zum Postfach bzw. zur bei Resend bestätigten Domain passen)
EMAIL_FROM="ERLEN <portal@erlen-sales.de>"
# Ohne E-Mail-Einstellungen zeigt das Portal den Einladungslink zum manuellen Weitergeben an.

# Optional: eigenes Geheimnis für den Erinnerungs-Zeitplaner (sonst automatisch abgeleitet)
CRON_SECRET=
